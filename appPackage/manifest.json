{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "manifestVersion": "1.25",
  "version": "1.0.11",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "TheLoops",
    "websiteUrl": "https://theloops.io",
    "privacyUrl": "https://theloops.io/privacy-policy/",
    "termsOfUseUrl": "https://theloops.io/terms-conditions/"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "${{BOT_NAME}}",
    "full": "${{BOT_NAME}}"
  },
  "description": {
    "short": "TheLoops bot: Dynamic Adaptive Cards, enhancing collaboration.",
    "full": "TheLoops is a bot designed to streamline team collaboration. It sends personalized messages and dynamically processes Adaptive Cards, allowing users to submit forms. It excels at sending Adaptive Cards in Teams, providing a user-friendly interface. The bot communicates with a backend system for data processing and seamlessly handles error situations. Whether it's facilitating onboarding, automating routine tasks, or enhancing communication, the LoopsBot is a valuable addition to any Microsoft Teams workspace, ensuring smoother team interactions and increased productivity."
  },
  "accentColor": "#661DC2",
  "supportsChannelFeatures": "tier1",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": [
        "personal",
        "team",
        "groupChat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": [
            "personal",
            "team",
            "groupChat"
          ],
          "commands": [
            {
              "title": "loops",
              "description": "A command to invoke workflow/actions on TheLoops"
            },
            {
              "title": "ask",
              "description": "A command to ask TheLoops questions"
            }
          ]
        }
      ]
    }
  ],
  "webApplicationInfo": {
    "id": "${{BOT_ID}}",
    "resource": "api://${{BOT_ID}}"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "ChannelMessage.Read.Group",
          "type": "Application"
        },
        {
          "name": "Member.Read.Group",
          "type": "Application"
        },
        {
          "name": "Team.Read.Group",
          "type": "Application"
        },
        {
          "name": "TeamsActivity.Send.Group",
          "type": "Application"
        },
        {
          "name": "TeamsTab.Create.Group",
          "type": "Application"
        },
        {
          "name": "TeamsTab.Read.Group",
          "type": "Application"
        },
        {
          "name": "TeamsTab.ReadWrite.Group",
          "type": "Application"
        }
      ]
    }
  },
  "composeExtensions": [],
  "configurableTabs": [
    {
      "configurationUrl": "https://agenthomepage.${{LOOPS_HOST}}/?env=prod",
      "canUpdateConfiguration": true,
      "scopes": [
        "team"
      ],
      "context": [
        "channelTab"
      ]
    }
  ],
  "staticTabs": [],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "token.botframework.com",
    "agenthomepage.${{LOOPS_HOST}}"
  ]
}