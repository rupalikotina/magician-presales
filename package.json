        "watch": "nodemon ./src/index.js",
        "test": "node --test"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com"
    },
    "dependencies": {
        "@microsoft/adaptivecards-tools": "^1.3.8",
        "@microsoft/teams-ai": "^1.7.0",
        "@microsoft/teamsfx": "^3.0.2",
        "adaptive-expressions": "^4.23.1",
        "adaptivecards-templating": "^2.3.1",
        "applicationinsights": "^2.9.8",
        "botbuilder": "^4.23.3",
        "express": "^5.0.1",
        "restify": "^11.1.0",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "env-cmd": "^10.1.0",
        "nodemon": "^3.1.7"
    },
    "keywords": [],
    "allowScripts": {
        "botbuilder-dialogs@4.23.3": true,
        "dtrace-provider@0.8.8": true,
        "fsevents@2.3.3": true,
        "protobufjs@7.6.5": true
    }
